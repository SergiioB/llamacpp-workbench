# Optional overrides for llama-webui

# Where runtime state, logs, and the SQLite DB live.
LLAMA_WEBUI_DATA_DIR=./data

# Colon-separated model search roots.
LLAMA_WEBUI_MODEL_DIRS=./models:$HOME/models

# Default destination for URL-triggered GGUF downloads.
LLAMA_WEBUI_DEFAULT_DOWNLOAD_DIR=./models

# Optional explicit llama.cpp binaries. If unset, llama-webui checks PATH
# and then common local build locations under third_party/llama.cpp.
LLAMA_WEBUI_LLAMA_SERVER=/absolute/path/to/llama-server
LLAMA_WEBUI_LLAMA_CLI=/absolute/path/to/llama-cli
